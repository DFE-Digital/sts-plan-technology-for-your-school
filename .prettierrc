{
  "printWidth": 100,
  "proseWrap": "always",
  "singleQuote": true,
  "trailingComma": "all",
  "useTabs": false,

  "overrides": [
    {
      "files": [
        "tsconfig.json",
        "tsconfig.*.json",
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "options": {
        "parser": "jsonc"
      }
    }
  ]
}
