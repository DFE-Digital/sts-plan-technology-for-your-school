@using Dfe.PlanTech.Core.Enums
@model MatStandardsListViewModel

<h1 class="govuk-heading-xl">Plan technology for your school</h1>

<p class="govuk-body">
    Submit self-assessments to get recommendations and track your progress towards meeting the core standards.
</p>

<h2 class="govuk-heading-l">
    View recommendations and track progress
</h2>

<div class="dfe-grid-container">
    @foreach (var category in Model.Categories)
    {
        @await Component.InvokeAsync(
        "CategorySection",
        new
        {
            category,
            context = CategoryLandingContext.MAT
        }
        )
        }
</div>
