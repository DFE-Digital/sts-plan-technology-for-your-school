@using Dfe.PlanTech.Core.Enums
@inject IMicrocopyProvider Microcopy
@model MatStandardsListViewModel

@section Breadcrumbs
{
    <partial name="_Breadcrumbs"
        model='new List<BreadcrumbItemViewModel>
        {
            new()
            {
                Text = "Home",
                Href = UrlConstants.HomePage
            }
        }'
    />
}

@{
    ViewData["UseOrganisationContextHeader"] = true;
}

@section OrganisationContext {
    <partial name="_OrganisationContext" model="Model.GroupName" />
}

<h1 class="govuk-heading-xl">
    @await Microcopy.GetTextByKeyAsync(ContentfulMicrocopyConstants.GroupsStandardsListHeader)
    </h1>

<p class="govuk-body">
    @await Microcopy.GetTextByKeyAsync(ContentfulMicrocopyConstants.GroupsStandardsListBody)
</p>

<h2 class="govuk-heading-l">
    @await Microcopy.GetTextByKeyAsync(ContentfulMicrocopyConstants.GroupsStandardsListCategoriesHeader)
</h2>

<div class="dfe-grid-container">
    @foreach (var category in Model.Categories)
    {
        @await Component.InvokeAsync(
        "CategorySection",
        new
        {
            category,
            context = CategoryLandingContext.MAT
        })
     }
</div>
