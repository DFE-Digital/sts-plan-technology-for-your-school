@using Dfe.PlanTech.Application.Providers.Interfaces
@inject IMicrocopyProvider Microcopy
@inject ICurrentUserProvider CurrentUser
@model PageViewModel

@{
    var isTopicStartPage = !string.IsNullOrWhiteSpace(Model.CategorySlug);

    var isSelectedSchoolHomePage =
        CurrentUser.IsMat &&
        !string.IsNullOrWhiteSpace(CurrentUser.GroupSelectedSchoolName) &&
        Model.Page.Slug == UrlConstants.HomePage.Replace("/", "");

    var useBreadcrumbs = isTopicStartPage || isSelectedSchoolHomePage;

    ViewData["UseBreadcrumbs"] = useBreadcrumbs;
    ViewData["UseOrganisationContextHeader"] = isTopicStartPage && Model.ShowTrustSchoolAssessmentTable;

    var breadcrumbs = new List<BreadcrumbItemViewModel>
    {
        new()
        {
            Text = "Home",
            Href = CurrentUser.IsMat
                ? UrlConstants.SelectASchoolPage
                : UrlConstants.HomePage
        }
    };

    if (isTopicStartPage)
    {
        if (Model.ShowTrustSchoolAssessmentTable)
        {
            breadcrumbs.Add(new BreadcrumbItemViewModel
            {
                Text = "Select self-assessment",
                Href = $"/trust/{UrlConstants.GroupSelfAssessmentSelectionSlug}"
            });
        }
        else
        {
            if (CurrentUser.IsMat &&
                !string.IsNullOrWhiteSpace(CurrentUser.GroupSelectedSchoolName))
            {
                breadcrumbs.Add(new BreadcrumbItemViewModel
                {
                    Text = CurrentUser.GroupSelectedSchoolName,
                    Href = UrlConstants.HomePage
                });
            }

            if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                breadcrumbs.Add(new BreadcrumbItemViewModel
                {
                    Text = Model.CategoryName,
                    Href = $"/{Model.CategorySlug}"
                });
            }
        }
    }
}

@section Breadcrumbs {
    @if (useBreadcrumbs)
    {
        <partial name="_Breadcrumbs" model="breadcrumbs" />
    }
}

@section OrganisationContext {
    @if (isTopicStartPage &&
             Model.ShowTrustSchoolAssessmentTable &&
             !string.IsNullOrWhiteSpace(CurrentUser.UserOrganisationName))
    {
        <partial name="_OrganisationContext" model="CurrentUser.UserOrganisationName" />
    }
}

@section NavButton {
    @if (!useBreadcrumbs)
    {
        @if (Model.Page.DisplayBackButton)
        {
            if (Model.ShowTrustSchoolAssessmentTable)
            {
                <govuk-back-link href="/trust/@UrlConstants.GroupSelfAssessmentSelectionSlug">
                    Back to select a self-assessment
                </govuk-back-link>
            }
            else
            {
                await Html.RenderPartialAsync("BackButton", Model);
            }
        }

        @if (Model.Page.DisplayHomeButton)
        {
            await Html.RenderPartialAsync("HomeButton", Model);
        }
    }
}

@foreach (var content in Model.Page.BeforeTitleContent)
{
    await Html.RenderPartialAsync("Components/PageComponentFactory", content);
}

@if (Model.Page.DisplayOrganisationName && !isTopicStartPage)
{
    <span class="govuk-caption-xl">
        @Model.ActiveEstablishmentName
    </span>
}

@if (Model.Page.Title != null)
{
    await Html.RenderPartialAsync("Components/Title", Model.Page.Title);
}

@{
    if (Model.Page.Slug == "home" && TempData.ContainsKey("SubtopicError"))
    {
        var error = TempData[StatePassingMechanismConstants.SubtopicError] as string;
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">
                    There is a problem
                </h2>
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="govuk-error-summary__body whitespace-preline">@Html.Raw(error)</div>
                }
            </div>
        </div>
    }

    var isHomeCategoryPage = Model.Page.Slug.Equals(UrlConstants.HomePage.Replace("/", ""));
    var isAutomatedTestingHomePage = Model.Page.Slug == UrlConstants.AutomatedTestingHomePage.Replace("/", "");
    var categories = Model.Page.Content?.OfType<QuestionnaireCategoryEntry>().ToList();

    @if ((isHomeCategoryPage || isAutomatedTestingHomePage) && categories is not null && categories.Any())
    {
        await Html.RenderPartialAsync("Components/Page", Model.Page);

        var homeHeader = await Microcopy.GetTextByKeyAsync(ContentfulMicrocopyConstants.HomeHeader);

        <h2 class="govuk-heading-l">@homeHeader</h2>
        <div class="dfe-grid-container">
            @foreach (var category in categories)
            {
                @await Component.InvokeAsync("CategorySection", new { category })
            }
        </div>
    }
    else
    {
        await Html.RenderPartialAsync("Components/Page", Model.Page);

        if (Model.ShowTrustSchoolAssessmentTable)
        {
            await Html.RenderPartialAsync("Components/TrustSchoolAssessmentTable", Model);
        }
    }

    @section RelatedActions {
        @if (Model.Page.RelatedActions.Any(x =>
                    !string.IsNullOrWhiteSpace(x.Title) &&
                    !string.IsNullOrWhiteSpace(x.Url)))
        {
            <hr class="govuk-section-break govuk-section-break--visible custom-hr-blue">

            <h2 class="govuk-heading-m govuk-!-padding-top-4">
                Related actions
            </h2>

            @foreach (var action in Model.Page.RelatedActions.Where(x =>
                    !string.IsNullOrWhiteSpace(x.Title) &&
                    !string.IsNullOrWhiteSpace(x.Url)))
            {
                <p class="govuk-body-s">
                    <a class="govuk-link" href="@action.Url">
                        @action.Title
                    </a>
                </p>
            }
        }
    }
}

@section AfterContent {
    @foreach (var content in Model.Page.AfterContentContent)
    {
        await Html.RenderPartialAsync("Components/PageComponentFactory", content);
    }
}
