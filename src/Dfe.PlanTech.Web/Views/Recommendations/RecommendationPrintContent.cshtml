@using Dfe.PlanTech.Application.Providers.Interfaces
@inject ICurrentUserProvider CurrentUser
@model RecommendationsViewModel

@{
    if (Model.CategoryName != null)
    {
        ViewData[StatePassingMechanismConstants.Title] = $"{Model.CategoryName} - print view";
    }
}

@if (Model.IsMat)
{
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">
        @Model.CategoryName
    </h1>

    <h2 class="govuk-heading-l">
        @Model.SectionName
    </h2>

    <hr class="govuk-section-break govuk-section-break--l">

    <h2 class="govuk-heading-l">
        Recommendations
    </h2>

    @foreach (var chunk in Model.Chunks)
    {
        <div class="recommendation-piece-content">
            <h3 class="govuk-heading-m">
                @chunk.HeaderText
            </h3>

            @foreach (var content in chunk.Content)
            {
                <partial name="Components/PageComponentFactory" model="@content" />
            }

            <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">
        </div>
    }
}
else
{
    var schoolName = await CurrentUser.GetActiveEstablishmentNameAsync();

    <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">
        @Model.CategoryName
    </h1>

    @if (!string.IsNullOrWhiteSpace(schoolName))
    {
        <p class="govuk-body-l">
            @schoolName
        </p>
    }

    <h2 class="govuk-heading-l">
        @Model.SectionName
    </h2>

    @if (!string.IsNullOrWhiteSpace(Model.LatestCompletionDate))
    {
        <p class="govuk-body">
            Self-assessment completed on @Model.LatestCompletionDate
        </p>
    }

    <hr class="govuk-section-break govuk-section-break--l">

    <h2 class="govuk-heading-l">
        Recommendations
    </h2>

    @foreach (var chunk in Model.Chunks)
    {
        <div class="recommendation-piece-content">
            <h3 class="govuk-heading-m">
                @chunk.HeaderText
            </h3>

            <div class="dfe-table-scroll" tabindex="0">
                <table class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">
                                Status
                            </th>
                            <th scope="col" class="govuk-table__header">
                                Updated
                            </th>
                        </tr>
                    </thead>

                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">
                                <strong class="govuk-tag @chunk.StatusTagClass">
                                    @chunk.Status.GetDisplayName()
                                </strong>
                            </td>

                            <td class="govuk-table__cell">
                                @chunk.LastUpdatedFormatted
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr class="govuk-section-break govuk-section-break--m">

            @foreach (var content in chunk.Content)
            {
                <partial name="Components/PageComponentFactory" model="@content" />
            }

            <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">
        </div>
    }
}
