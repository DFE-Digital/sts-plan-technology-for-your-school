@inject ICurrentUserProvider CurrentUser
@model CategoryLandingPageViewModel

@{
    var breadcrumbs = new List<BreadcrumbItemViewModel>
    {
        new()
        {
            Text = "Home",
            Href = CurrentUser.IsMat
                ? UrlConstants.SelectASchoolPage
                : UrlConstants.HomePage
        }
    };

    if (Model.Context == CategoryLandingContext.MAT)
    {
        breadcrumbs.Add(new BreadcrumbItemViewModel
        {
            Text = "Select a standard",
            Href = UrlConstants.GroupStandards
        });
    }
    else if (CurrentUser.IsMat &&
             !string.IsNullOrWhiteSpace(CurrentUser.GroupSelectedSchoolName))
    {
        breadcrumbs.Add(new BreadcrumbItemViewModel
        {
            Text = CurrentUser.GroupSelectedSchoolName,
            Href = UrlConstants.HomePage
        });
    }

    ViewData["UseOrganisationContextHeader"] =
        Model.Context == CategoryLandingContext.MAT;
}

@section Breadcrumbs {
    <partial name="_Breadcrumbs" model="breadcrumbs" />
}

@section OrganisationContext {
    @if (Model.Context == CategoryLandingContext.MAT &&
             !string.IsNullOrWhiteSpace(CurrentUser.UserOrganisationName))
    {
        <partial name="_OrganisationContext" model="CurrentUser.UserOrganisationName" />
    }
}

@section RelatedActions {
    @if (Model.RelatedActions.Any())
    {
        <hr class="govuk-section-break govuk-section-break--visible custom-hr-blue">

        <h2 class="govuk-heading-m govuk-!-padding-top-4">
            Related actions
        </h2>

        @foreach (var action in Model.RelatedActions)
        {
            var actionText = action.Text;
            var actionUrl = action.Url;

            if (Model.Context == CategoryLandingContext.MAT)
            {
                if (action.Url.Contains("print", StringComparison.OrdinalIgnoreCase))
                {
                    actionText = "Print this list of recommendations";

                    actionUrl = Url.RouteUrl(
                        nameof(PagesController.PrintMatStandard),
                        new { categorySlug = Model.Slug }
                    )!;
                }
                else if (action.Url.Contains("share", StringComparison.OrdinalIgnoreCase))
                {
                    actionText = "Share this list of recommendations";

                    actionUrl = Url.RouteUrl(
                        nameof(PagesController.ShareMatStandard),
                        new { categorySlug = Model.Slug }
                    )!;
                }
            }

            <p class="govuk-body-s">
                <a class="govuk-link" href="@actionUrl">
                    @actionText
                </a>
            </p>
        }
    }
}

@foreach (var content in Model.BeforeTitleContent)
{
    await Html.RenderPartialAsync("Components/PageComponentFactory", content);
}

@await Component.InvokeAsync("CategoryLanding", new {
category = Model.Category,
    slug = Model.Slug,
    sectionName = Model.SectionName,
    sortOrder = Model.SortOrder,
    Context = Model.Context
})

@section AfterContent {
    @foreach (var content in Model.AfterContentContent)
    {
        await Html.RenderPartialAsync("Components/PageComponentFactory", content);
    }
}
