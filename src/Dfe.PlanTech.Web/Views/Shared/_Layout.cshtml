@using Dfe.PlanTech.Infrastructure.SignIn.Models
@inject ICurrentUserProvider CurrentUser

@{
    Layout = "_GovUkPageTemplate";

    if (ViewData[StatePassingMechanismConstants.Title] == null)
    {
        var routeData = Context.GetRouteData();
        ViewData[StatePassingMechanismConstants.Title] = routeData.GetTitleForPage();
    }
}

@section Head {
    <partial name="_Head" />
    @await RenderSectionAsync("CSS", required: false)
    <partial name="GoogleTagManager/_Head" />
    @await RenderSectionAsync("Head", required: false)
}

@section Header {
    <partial name="GoogleTagManager/_Body" />
    <partial name="CookiesBanner/_CookieBanner" />
    <partial name="_Header" />
}

@{
    var useOrganisationContextHeader =
        ViewData["UseOrganisationContextHeader"] is true;

    var useBreadcrumbs =
        ViewData["UseBreadcrumbs"] is true
        || (IsSectionDefined("Breadcrumbs") && !IsSectionDefined("NavButton"));
}

@section BeforeContent {
    @if (useOrganisationContextHeader)
    {
        <div class="organisation-context-header">
            <partial name="BetaHeader" />

            @if (useBreadcrumbs && IsSectionDefined("Breadcrumbs"))
            {
                @await RenderSectionAsync("Breadcrumbs", required: false)
            }
            else if (IsSectionDefined("NavButton"))
            {
                <nav aria-label="Back">
                    @await RenderSectionAsync("NavButton", required: false)
                </nav>
            }

            @if (IsSectionDefined("OrganisationContext"))
            {
                @await RenderSectionAsync("OrganisationContext", required: false)
            }
        </div>
    }
    else
    {
        <partial name="BetaHeader" />

        @if (useBreadcrumbs && IsSectionDefined("Breadcrumbs"))
        {
            @await RenderSectionAsync("Breadcrumbs", required: false)
        }
        else if (IsSectionDefined("NavButton"))
        {
            <nav aria-label="Back">
                @await RenderSectionAsync("NavButton", required: false)
            </nav>
        }

        @if (IsSectionDefined("OrganisationContext"))
        {
            IgnoreSection("OrganisationContext");
        }
    }

    @if (!useBreadcrumbs && IsSectionDefined("Breadcrumbs"))
    {
        IgnoreSection("Breadcrumbs");
    }

    @if (useBreadcrumbs && IsSectionDefined("NavButton"))
    {
        IgnoreSection("NavButton");
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
        @await RenderSectionAsync("Panel", required: false)
        @RenderBody()
        <script src="~/js/site.bundle.js"></script>
    </div>

    <div class="govuk-grid-column-one-third-from-desktop govuk-float-right">
        @await RenderSectionAsync("RelatedActions", required: false)
    </div>
</div>

@section Footer {
    @await RenderSectionAsync("AfterContent", required: false)
    <partial name="_Footer" />
}

@section BodyEnd {
    <partial name="_BodyEnd" />
    @await RenderSectionAsync("BodyEnd", required: false)
}
