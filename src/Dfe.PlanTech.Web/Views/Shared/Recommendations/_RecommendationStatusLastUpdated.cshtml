@model (string StatusText, string StatusTagClass, string LastUpdatedFormatted)
<div class="dfe-table-scroll" tabindex="0">
    <table class="govuk-table">
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Updated</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">
                <strong class="govuk-tag @Model.StatusTagClass">
                    @Model.StatusText
                </strong>
            </td>
            <td class="govuk-table__cell">@Model.LastUpdatedFormatted</td>
        </tr>
        </tbody>
    </table>
</div>

